{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Nginx Web Server",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "description": "Number of replicas for the Nginx deployment.",
      "default": 1
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "description": "Nginx image repository.",
          "default": "nginx"
        },
        "pullPolicy": {
          "type": "string",
          "description": "Image pull policy.",
          "default": "IfNotPresent"
        },
        "tag": {
          "type": "string",
          "description": "Nginx image tag.",
          "default": "1.16.0"
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "Service type.",
          "default": "ClusterIP"
        },
        "port": {
          "type": "integer",
          "description": "Service port.",
          "default": 80
        }
      }
    }
  }
}
